+    def _retrieve_from_opencode_store(self, hash_key: str) -> dict[str, Any] | None:
+        """[opencode-patch] Legge il contenuto originale dal context-store su disco.
+
+        Fallback per gli hash scritti dal plugin opencode auto-headroom, che non
+        passano dagli store interni (local store / proxy).
+        """
+        try:
+            safe_name = Path(hash_key).name
+            if not safe_name or safe_name != hash_key or safe_name in (".", ".."):
+                return None
+            txt_path = OPENCODE_CONTEXT_STORE_DIR / f"{safe_name}.txt"
+            if not txt_path.is_file():
+                return None
+            content = txt_path.read_text(encoding="utf-8")
+        except (OSError, ValueError):
+            return None
+        return {
+            "hash": hash_key,
+            "source": "opencode-context-store",
+            "original_content": content,
+            "bytes": len(content.encode("utf-8")),
+            "path": str(txt_path),
+        }
+
