{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash-vision-exp",
  "small_model": "opencode-go/deepseek-v4-flash",
  "subagent_depth": 2,
  "default_agent": "router",
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "options": {},
      "permission": {}
    },
    "scout": {
      "model": "opencode-go/deepseek-v4-flash",
      "options": {},
      "permission": {}
    }
  },
  "provider": {
    "llama-local": {
      "name": "LLM Locale",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "dummy"
      },
      "models": {
        "local": {
          "name": "Qwen3.6-35B-A3B-UDT-Q3_K_XL_MTP"
        }
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3"
        },
        "glm-5.2": {
          "name": "GLM-5.2"
        },
        "glm-5.1": {
          "name": "GLM-5.1"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision Exp"
        },
        "mimo-v2.5": {
          "name": "MiMo-V2.5"
        },
        "mimo-v2.5-pro": {
          "name": "MiMo-V2.5 Pro"
        },
        "minimax-m3": {
          "name": "MiniMax M3"
        },
        "minimax-m2.7": {
          "name": "MiniMax M2.7"
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus"
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus"
        }
      }
    }
  },
  "plugin": [],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "headroom_*": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "*": "allow"
    },
    "read": {
      "*.env": "allow",
      "*.env.*": "allow"
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.local/share/opencode/headroom-venv/bin/headroom\" mcp serve"
      ],
      "enabled": true
    },
    "trading": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.local/share/opencode/trading-mcp-venv/bin/trading-mcp\""
      ],
      "enabled": true
    },
    "alphavantage": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.local/bin/alphavantage-mcp.sh\""
      ],
      "enabled": true
    }
  },
  "shell": "/bin/zsh"
}