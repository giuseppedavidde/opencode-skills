{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "router",
  "experimental": {
    "subagent_depth": 3
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "options": {},
      "permission": {}
    }
  },
  "provider": {
    "opencode-go": {
      "name": "OpenCode Go",
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3"
        },
        "glm-5.2": {
          "name": "GLM-5.2"
        },
        "glm-5.1": {
          "name": "GLM-5.1"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision Exp"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "mimo-v2.5": {
          "name": "MiMo-V2.5"
        },
        "mimo-v2.5-pro": {
          "name": "MiMo-V2.5 Pro"
        },
        "minimax-m3": {
          "name": "MiniMax M3"
        },
        "minimax-m2.7": {
          "name": "MiniMax M2.7"
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus"
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus"
        }
      }
    }
  },
  "plugins": [
    {
      "package": "/home/giuseppe/Progetti/Github/opencode-skills/plugins/auto-headroom"
    },
    {
      "package": "/home/giuseppe/Progetti/Github/opencode-skills/plugins/graphify"
    },
    {
      "package": "/home/giuseppe/Progetti/Github/opencode-skills/plugins/routing-stats"
    },
    {
      "package": "/home/giuseppe/Progetti/Github/opencode-skills/plugins/tokens-per-second"
    },
    {
      "package": "/home/giuseppe/Progetti/Github/opencode-skills/plugins/verifica-gate"
    }
  ],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "headroom_*": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "*": "allow"
    },
    "read": {
      "*.env": "allow",
      "*.env.*": "allow"
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.local/share/opencode/headroom-venv/bin/headroom\" mcp serve"
      ],
      "enabled": true
    },
    "trading": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.local/share/opencode/trading-mcp-venv/bin/trading-mcp\""
      ],
      "enabled": true
    }
  },
  "shell": "/bin/zsh"
}
