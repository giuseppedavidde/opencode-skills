[Unit]
Description=Preselect the opencode-skills agent and model for VS Code
Documentation=file://%h/.config/opencode/opencode-skills/vscode/README.md
Before=graphical-session.target

[Service]
Type=oneshot
# install.sh creates ~/.config/opencode/opencode-skills -> <repository> on every machine.
WorkingDirectory=%h/.config/opencode/opencode-skills
ExecStart=%h/.config/opencode/opencode-skills/scripts/vscode-preselect.py
# Exit code 2 means VS Code was already running; keep the login clean.
SuccessExitStatus=2

[Install]
WantedBy=graphical-session-pre.target
